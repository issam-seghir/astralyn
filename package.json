{
	"name": "astralyn",
	"author": "issam-seghir",
	"private": true,
	"version": "1.0.0",
	"license": "GPL-3.0",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@10.33.0",
	"browserslist": [
		"defaults and supports es6-module",
		"maintained node versions"
	],
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"clean": "rm -rf dist test",
		"sass:watch": "sass src/scss/main.scss css/main.css --watch --no-source-map --error-css",
		"lint:js": "eslint \"src/**/*.{js,jsx,ts,tsx,html}\" \"index.html\"",
		"lint:js:fix": "pnpm lint:js -- --fix",
		"lint:style": "stylelint \"src/**/*.{html,css,scss}\" \"*.html\" --cache",
		"lint:style:fix": "pnpm lint:style -- --fix",
		"lint": "pnpm lint:js && pnpm lint:style",
		"lint:fix": "pnpm lint:js:fix && pnpm lint:style:fix"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-alias": "^1.1.2",
		"eslint-plugin-compat": "^7.0.2",
		"eslint-plugin-html": "^8.1.4",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-jsonc": "^3.4.1",
		"eslint-plugin-jsx-a11y": "^6.10.2",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.4",
		"eslint-plugin-security": "^4.0.1",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"eslint-plugin-sonarjs": "^4.2.0",
		"eslint-plugin-unicorn": "^73.0.0",
		"gerillass": "^3.0.0",
		"globals": "^17.11.0",
		"postcss-html": "^2.0.0",
		"postcss-inline-svg": "^6.0.0",
		"postcss-markdown": "^2.0.0",
		"postcss-preset-env": "^11.6.1",
		"sass": "~1.106.0",
		"stylelint": "^17.14.1",
		"stylelint-config-clean-order": "^10.0.0",
		"stylelint-config-html": "^2.0.0",
		"stylelint-config-standard": "^40.0.0",
		"stylelint-config-standard-scss": "^17.0.0",
		"stylelint-high-performance-animation": "^2.0.0",
		"vite": "^8.2.1",
		"vite-plugin-svgr": "^5.2.0"
	},
	"dependencies": {
		"@emotion/react": "^11.11.1",
		"@emotion/styled": "^11.11.0",
		"@fontsource/inter": "^5.0.15",
		"@mui/joy": "^5.0.0-beta.52",
		"@syncfusion/ej2": "^34.2.4",
		"@syncfusion/ej2-base": "^34.2.4",
		"@syncfusion/ej2-data": "^34.2.2",
		"@syncfusion/ej2-layouts": "^34.2.3",
		"@syncfusion/ej2-react-calendars": "^34.2.4",
		"@syncfusion/ej2-react-charts": "^34.2.4",
		"@syncfusion/ej2-react-diagrams": "^34.2.4",
		"@syncfusion/ej2-react-grids": "^34.2.4",
		"@syncfusion/ej2-react-kanban": "^34.2.4",
		"@syncfusion/ej2-react-layouts": "^34.2.3",
		"@syncfusion/ej2-react-richtexteditor": "^34.2.4",
		"@syncfusion/ej2-react-schedule": "^34.2.4",
		"@uidotdev/usehooks": "^2.4.1",
		"cldr-data": "^36.0.4",
		"leaflet": "^1.9.4",
		"leaflet-geosearch": "^4.4.0",
		"leaflet.fullscreen": "^5.3.3",
		"marked": "^18.0.10",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-helmet-async": "^3.0.0",
		"react-icons": "^5.7.0",
		"react-leaflet": "^5.0.0",
		"react-router": "^8.3.0",
		"rfs": "^10.0.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"@parcel/watcher",
			"cldr-data",
			"esbuild",
			"unrs-resolver"
		]
	}
}
